        "message": "=<p>Hi {{ $json[\"Student Name\"] }} ({{ $json[\"Student Id\"] }}),</p>\n\n<!-- Bold header with dynamic color based on the result status -->\n<p><b>Student Test Result:</b></p>\n\n<table style=\"border-collapse: collapse; width: 100%; max-width: 400px; font-family: Arial, sans-serif; margin: 15px 0;\">\n  <tr style=\"border-bottom: 2px solid #333;\">\n    <th style=\"text-align: left; padding: 8px; font-weight: bold;\">Student Name :</th>\n    <td style=\"padding: 8px;\">{{ $json[\"Student Name\"] }}</td>\n  </tr>\n  <tr style=\"border-bottom: 2px solid #333;\">\n    <th style=\"text-align: left; padding: 8px; font-weight: bold;\">Student Id :</th>\n    <td style=\"padding: 8px;\">{{ $json[\"Student Id\"] }}</td>\n  </tr>\n</table>\n\n<table style=\"border-collapse: collapse; width: 100%; max-width: 400px; font-family: Arial, sans-serif;\">\n  <thead>\n    <tr style=\"background-color: #f2f2f2; border-bottom: 2px solid #333;\">\n      <th style=\"text-align: left; padding: 8px;\">Subject</th>\n      <th style=\"text-align: left; padding: 8px;\">Marks</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr style=\"border-bottom: 1px solid #ddd;\">\n      <td style=\"padding: 8px;\">Maths</td>\n      <td style=\"padding: 8px;\">{{ $json[\"Maths\"] }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #ddd;\">\n      <td style=\"padding: 8px;\">English</td>\n      <td style=\"padding: 8px;\">{{ $json[\"English\"] }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #ddd;\">\n      <td style=\"padding: 8px;\">Tamil</td>\n      <td style=\"padding: 8px;\">{{ $json[\"Tamil\"] }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #ddd;\">\n      <td style=\"padding: 8px;\">Science</td>\n      <td style=\"padding: 8px;\">{{ $json[\"Science\"] }}</td>\n    </tr>\n    <tr style=\"border-bottom: 2px solid #333;\">\n      <td style=\"padding: 8px;\">Practicals</td>\n      <td style=\"padding: 8px;\">{{ $json[\"Practicals\"] }}</td>\n    </tr>\n    <!-- Dynamic inline color applied to the final result cell -->\n    <tr style=\"font-weight: bold; background-color: #fafafa;\">\n      <td style=\"padding: 8px;\">Result:</td>\n      <td style=\"padding: 8px; color: {{ $json['Result'].toLowerCase() === 'pass' ? '#2e7d32' : '#d32f2f' }};\">{{ $json[\"Result\"] }}</td>\n    </tr>\n  </tbody>\n</table>\n\n<p style=\"margin-top: 20px;\">Regards,<br>School Management</p>\n",
